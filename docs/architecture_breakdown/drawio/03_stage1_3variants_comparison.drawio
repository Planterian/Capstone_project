<mxfile host="app.diagrams.net" modified="2026-11-04T08:10:00.000Z" agent="Mozilla/5.0" version="21.0.0">
  <diagram id="diag_stage1_variants" name="Stage 1 Architecture Variants Comparison">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title_box" value="STAGE 1: QK^T GEMM DESIGN SPACE EXPLORATION (3 HARDWARE VARIANTS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=#006EAF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="40" as="geometry" />
        </mxCell>

        <!-- Variant 1A -->
        <mxCell id="box_v1a" value="VARIANT 1A: Pure LUT Streaming Engine&#xa;(Target: 0 DSP Usage - 100% FPGA Logic Fabric)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="350" height="520" as="geometry" />
        </mxCell>

        <mxCell id="v1a_inputs" value="Inputs: Query Vector q_i [127:0] &amp; Key Token k_j [127:0]&#xa;Broadcast 16x INT8 query &amp; key elements per clock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="box_v1a">
          <mxGeometry x="15" y="40" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="v1a_mults" value="16x Parallel Pure LUT Signed Multipliers&#xa;(lut_multiplier_8x8.sv)&#xa;16 pairs of INT8 x INT8 -> 16-bit Signed Products&#xa;Uses CLB LUT6 Fabric | ZERO DSP48E2 SLICES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="box_v1a">
          <mxGeometry x="15" y="95" width="320" height="65" as="geometry" />
        </mxCell>

        <mxCell id="v1a_tree" value="4-Stage Pipelined Reduction Adder Tree&#xa;(pipelined_adder_tree.sv)&#xa;• Level 1: 8 adders (16 -> 8 values) [Reg L1]&#xa;• Level 2: 4 adders (8 -> 4 values) [Reg L2]&#xa;• Level 3: 2 adders (4 -> 2 values) [Reg L3]&#xa;• Level 4: 1 final adder (2 -> 1 INT32 sum) [Reg L4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="box_v1a">
          <mxGeometry x="15" y="175" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="v1a_output" value="Streaming Output: INT32 Raw Score&#xa;Throughput: 1 score / clock cycle (II = 1)&#xa;Latency: 5 clock cycles | Zero drain overhead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="box_v1a">
          <mxGeometry x="15" y="290" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="v1a_proscons" value="Architectural Characteristics:&#xa;[+] ZERO DSP usage (frees all DSPs for CNN backbones)&#xa;[+] High Fmax (~330 MHz due to 4 pipeline stages)&#xa;[-] High LUT consumption (~5,150 LUTs)&#xa;[-] Higher dynamic routing congestion in dense fabric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="box_v1a">
          <mxGeometry x="15" y="355" width="320" height="145" as="geometry" />
        </mxCell>

        <!-- Variant 2A -->
        <mxCell id="box_v2a" value="VARIANT 2A: DSP-Packed Streaming Engine (RECOMMENDED)&#xa;(Target: Maximum LUT Efficiency &amp; 200MHz Timing Closure)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="360" height="520" as="geometry" />
        </mxCell>

        <mxCell id="v2a_inputs" value="Inputs: Query Vector q_i [127:0] &amp; Key Token k_j [127:0]&#xa;Vector unpack: 8 pairs mapped to 8 DSP slices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="box_v2a">
          <mxGeometry x="15" y="40" width="330" height="40" as="geometry" />
        </mxCell>

        <mxCell id="v2a_dsppack" value="8x pe_slice_dsp_packing (DSP48E2 Hardware Multiplier)&#xa;Packs 2 INT8 Multiplications per 1 DSP48E2 (18x27-bit):&#xa;• Product = A x (B &lt;&lt; 18 + C) = (A x B)&lt;&lt;18 + (A x C)&#xa;• Hardware Borrow-Bit Correction: (P &gt;&gt;&gt; 18) + (P[15] ? 1 : 0)&#xa;• ONLY 8 DSP48E2 Slices for entire 16-element GEMM!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="box_v2a">
          <mxGeometry x="15" y="95" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="v2a_tree" value="3-Stage Pipelined Reduction Adder Tree&#xa;Sums 16 unpacked products into INT32 raw score&#xa;Registers: Stage 1 (DSP output), Stage 2 &amp; 3 (Adder tree)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="box_v2a">
          <mxGeometry x="15" y="195" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="v2a_output" value="Streaming Output: INT32 Raw Score&#xa;Throughput: 1 score / clock cycle (II = 1)&#xa;Latency: 4 clock cycles | Closed timing WNS = +0.051 ns @ 200MHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="box_v2a">
          <mxGeometry x="15" y="270" width="330" height="50" as="geometry" />
        </mxCell>

        <mxCell id="v2a_proscons" value="Architectural Characteristics:&#xa;[+] LOWEST LUT USAGE (~2,700 LUTs, 47.6% less than 1A)&#xa;[+] HIGHEST Fmax (~408 MHz capable, 200 MHz target met)&#xa;[+] Zero-Bubble Streaming (II = 1, Drain Phase = 0)&#xa;[+] Top-tier Real-Time Attention Frame Rate: 238.2 FPS&#xa;[+] Proven Bit-Exactness with I-ViT Software Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="box_v2a">
          <mxGeometry x="15" y="335" width="330" height="165" as="geometry" />
        </mxCell>

        <!-- Variant 3B -->
        <mxCell id="box_v3b" value="VARIANT 3B: 2D Spatial Systolic Array&#xa;(Target: High Scalability for Large ViT Models)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="80" width="350" height="520" as="geometry" />
        </mxCell>

        <mxCell id="v3b_inputs" value="Inputs: Tiled Query &amp; Key Matrices (4x8 Tiles)&#xa;Tiling controller schedules sub-matrices into 2D grid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="box_v3b">
          <mxGeometry x="15" y="40" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="v3b_grid" value="4x4 PE 2D Systolic Array (16 DSP48E2 Slices)&#xa;Output-Stationary Dataflow:&#xa;• 32 MACs calculated per clock cycle&#xa;• Computation Phase: 24 clock cycles&#xa;• DRAIN PHASE: 32 clock cycles to unload accumulators!&#xa;• Idle stall percentage: 32 / (24+32) = 57.1% !" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="box_v3b">
          <mxGeometry x="15" y="95" width="320" height="95" as="geometry" />
        </mxCell>

        <mxCell id="v3b_reorder" value="Score Matrix Reordering Buffer (score_reorder_buffer.sv)&#xa;Converts 4x8 Tile-ordered output into continuous row-order&#xa;Required by Hardware Softmax 1-row streaming interface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="box_v3b">
          <mxGeometry x="15" y="200" width="320" height="65" as="geometry" />
        </mxCell>

        <mxCell id="v3b_output" value="Tiled Output -> Row-reordered Stream&#xa;Sustained Throughput: 0.57 score / clock (32 / 56)&#xa;Attention Frame Rate: 148.3 FPS (60.6% slower than 2A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="box_v3b">
          <mxGeometry x="15" y="280" width="320" height="55" as="geometry" />
        </mxCell>

        <mxCell id="v3b_proscons" value="Architectural Characteristics:&#xa;[+] High regular 2D routing (ideal for ASIC/large arrays)&#xa;[+] Highly scalable to large ViT models (dk=64, 128)&#xa;[-] Suffers from severe Drain Overhead on edge models (dk=16)&#xa;[-] Requires complex Tiling FSM &amp; Reordering BRAM&#xa;[-] Lower FPS (148.3 FPS) due to pipeline bubbles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="box_v3b">
          <mxGeometry x="15" y="350" width="320" height="150" as="geometry" />
        </mxCell>

        <!-- Summary Matrix Table -->
        <mxCell id="tbl_comp" value="QUANTITATIVE SYNTHESIS &amp; PERFORMANCE COMPARISON MATRIX (AMD Kria KV260 @ 200 MHz, N=256, dk=16, H=4)&#xa;Metric                      | Variant 1A (LUT Stream)       | Variant 2A (DSP Stream) [BEST] | Variant 3B (Systolic Array)&#xa;• DSP48E2 Utilization       | 0 DSP (0.0%)                  | 8 DSP (0.64%)                  | 16 DSP (1.28%)&#xa;• CLB LUT6 Fabric           | ~5,150 LUTs (4.4%)            | ~2,700 LUTs (2.3%)             | ~4,200 LUTs (3.6%)&#xa;• Worst Negative Slack (WNS)| +1.98 ns                      | +0.051 ns (Timing Closed)      | +1.02 ns&#xa;• Sustained GEMM Throughput | 1.0 score / cycle (II = 1)    | 1.0 score / cycle (II = 1)     | 0.57 score / cycle (32/56)&#xa;• Full-Head Execution Time  | 1.048 ms (4.19 ms for 4 heads)| 1.050 ms (4.20 ms for 4 heads) | 1.686 ms (6.74 ms for 4 heads)&#xa;• Attention Frame Rate      | 238.5 FPS                     | 238.2 FPS                      | 148.3 FPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b5797;fontColor=#ffffff;fontStyle=1;fontSize=10;strokeColor=#1e395b;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1120" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
