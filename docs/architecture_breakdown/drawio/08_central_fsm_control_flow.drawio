<mxfile host="app.diagrams.net" modified="2026-11-04T14:25:00.000Z" agent="Mozilla/5.0" version="21.0.0">
  <diagram id="diag_fsm_control" name="Central FSM Control Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title_box" value="CENTRAL HARDWARE FSM CONTROLLER: attention_core_top_2A.sv (INGRESS &amp; MHA COMPUTE FSM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;fontStyle=1;fontSize=13;strokeColor=#0027b4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="40" as="geometry" />
        </mxCell>

        <!-- Ingress FSM Container -->
        <mxCell id="box_ing_fsm" value="INGRESS LOADING FSM (ing_load_state_t)&#xa;Unpacks 128-bit beats (16x INT8) into q_mem, k_mem, v_mem" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="1120" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ing_q" value="ING_Q (2'b00)&#xa;Loads Q beats&#xa;(0..beats_per_mat-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="box_ing_fsm">
          <mxGeometry x="30" y="35" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ing_k" value="ING_K (2'b01)&#xa;Loads K beats&#xa;(0..beats_per_mat-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="box_ing_fsm">
          <mxGeometry x="320" y="35" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ing_v" value="ING_V (2'b10)&#xa;Loads V beats&#xa;(0..beats_per_mat-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="box_ing_fsm">
          <mxGeometry x="610" y="35" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ing_ready" value="ING_READY (2'b11)&#xa;head_data_ready &lt;= 1&#xa;skid_tready &lt;= 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="box_ing_fsm">
          <mxGeometry x="890" y="35" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e_ing1" value="Q done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_ing_fsm" source="ing_q" target="ing_k">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_ing2" value="K done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_ing_fsm" source="ing_k" target="ing_v">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_ing3" value="V done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_ing_fsm" source="ing_v" target="ing_ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Compute States -->
        <mxCell id="box_comp_fsm" value="MHA COMPUTE &amp; SEQUENTIAL HEAD FSM (mha_state_t)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1120" height="570" as="geometry" />
        </mxCell>

        <mxCell id="mha_idle" value="MHA_IDLE (4'b0000)&#xa;• Core status: BUSY=0, DONE=0&#xa;• Await start_pulse from Reg 0x00[0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="30" y="40" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="mha_wait_data" value="MHA_WAIT_DATA (4'b0001)&#xa;• Wait for head_data_ready == 1&#xa;• Assert bram_read_en &lt;= 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="320" y="40" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="mha_row_start" value="MHA_ROW_START (4'b0010)&#xa;• Latch query vector q_curr_vec&#xa;• q_curr_vec &lt;= q_mem_lo[q_row_idx]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="610" y="40" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="mha_row_prep" value="MHA_ROW_PREP (4'b0011)&#xa;• row_start_pulse &lt;= 1&#xa;• k_stream_valid &lt;= 1, k_pair_idx &lt;= 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="890" y="40" width="200" height="65" as="geometry" />
        </mxCell>

        <mxCell id="mha_row_gemm" value="MHA_ROW_GEMM_K (4'b0100)&#xa;• Stream 128 Key token pairs (k_even, k_odd)&#xa;• 8x pe_slice_dsp_packing (DSP Packing)&#xa;• k_pair_idx: 0 to (N/2 - 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=10;fontStyle=1;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="870" y="160" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mha_row_wait" value="MHA_ROW_WAIT (4'b0101)&#xa;• Wait for Stage 3 &amp; Stage 4 completion&#xa;• Advance when score_v_row_done == 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="580" y="160" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mha_row_next" value="MHA_ROW_NEXT (4'b0110)&#xa;• Check row counter: q_row_idx &lt; N-1 ?&#xa;  - Yes: q_row_idx++, return to MHA_ROW_START&#xa;  - No: advance to MHA_HEAD_NEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="270" y="160" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mha_head_next" value="MHA_HEAD_NEXT (4'b0111)&#xa;• Check head counter: head_cnt &lt; H-1 ?&#xa;  - Yes: head_cnt++, reset bank &amp; MHA_WAIT_DATA&#xa;  - No: advance to MHA_DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="270" y="290" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mha_done" value="MHA_DONE (4'b1000)&#xa;• Assert STATUS Reg 0x04[1] = 1 (DONE)&#xa;• Deassert BUSY Reg 0x04[0] = 0&#xa;• Generate completion interrupt to ARM PS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;fontStyle=1;fontSize=10;" vertex="1" parent="box_comp_fsm">
          <mxGeometry x="30" y="290" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_c1" value="start_pulse = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_idle" target="mha_wait_data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c2" value="head_data_ready = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_wait_data" target="mha_row_start">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c3" value="Query latched" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_row_start" target="mha_row_prep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c4" value="Start K stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_row_prep" target="mha_row_gemm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c5" value="k_pair_idx == max" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_row_gemm" target="mha_row_wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c6" value="score_v_row_done = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_row_wait" target="mha_row_next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c7" value="q_row_idx &lt; N-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_row_next" target="mha_row_start">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="130" />
              <mxPoint x="720" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_c8" value="q_row_idx == N-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_row_next" target="mha_head_next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_c9" value="head_cnt &lt; H-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_head_next" target="mha_wait_data">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="270" />
              <mxPoint x="430" y="115" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_c10" value="head_cnt == H-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="box_comp_fsm" source="mha_head_next" target="mha_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>