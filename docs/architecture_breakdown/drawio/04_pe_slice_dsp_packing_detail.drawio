<mxfile host="app.diagrams.net" modified="2026-11-04T08:15:00.000Z" agent="Mozilla/5.0" version="21.0.0">
  <diagram id="diag_dsp_packing" name="DSP Packing Microarchitecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title_box" value="MICROARCHITECTURE DEEP DIVE: pe_slice_dsp_packing (DSP48E2 Dual-INT8 Multiplier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="40" as="geometry" />
        </mxCell>

        <!-- Inputs Container -->
        <mxCell id="box_inputs" value="INPUT OPERANDS (8-bit Signed Two's Complement)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="360" as="geometry" />
        </mxCell>

        <mxCell id="in_a" value="operand_a [7:0] (INT8)&#xa;Common Query Element Q[i, k]&#xa;Range: [-128, +127]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="box_inputs">
          <mxGeometry x="15" y="40" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="in_b" value="operand_b [7:0] (INT8)&#xa;Key Element 1: K[j, 2k]&#xa;Range: [-128, +127]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="box_inputs">
          <mxGeometry x="15" y="140" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="in_c" value="operand_c [7:0] (INT8)&#xa;Key Element 2: K[j, 2k+1]&#xa;Range: [-128, +127]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="box_inputs">
          <mxGeometry x="15" y="240" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- Packing Pre-Processing -->
        <mxCell id="box_pre" value="OPERAND PACKING &amp; SIGN EXTENSION LOGIC" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="280" height="360" as="geometry" />
        </mxCell>

        <mxCell id="ext_a" value="Sign Extension to 18 bits (Port A)&#xa;A_ext [17:0] = {{10{operand_a[7]}}, operand_a[7:0]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="box_pre">
          <mxGeometry x="15" y="40" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="shift_b" value="Shift Left 18 bits (Operand B)&#xa;B_shifted [26:0] = SignExtend(operand_b) &lt;&lt; 18" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="box_pre">
          <mxGeometry x="15" y="140" width="250" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ext_c" value="Sign Extension to 27 bits (Operand C)&#xa;C_ext [26:0] = {{19{operand_c[7]}}, operand_c[7:0]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="box_pre">
          <mxGeometry x="15" y="210" width="250" height="50" as="geometry" />
        </mxCell>

        <mxCell id="pack_add" value="Packed Port B Combiner (27-bit Signed)&#xa;P_packed [26:0] = B_shifted + C_ext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="box_pre">
          <mxGeometry x="15" y="280" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- Hard DSP48E2 -->
        <mxCell id="box_dsp" value="AMD UltraScale+ DSP48E2 HARD PRIMITIVE" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="230" height="360" as="geometry" />
        </mxCell>

        <mxCell id="dsp_mult" value="DSP48E2 Signed Multiplier&#xa;Port A: 18-bit signed&#xa;Port B: 27-bit signed&#xa;Hardware Pipeline Stage 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="box_dsp">
          <mxGeometry x="15" y="50" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="dsp_reg" value="DSP Internal Output Register (P-REG)&#xa;dsp_product [44:0] (45-bit Signed)&#xa;Formula: P = A x (B x 2^18 + C)&#xa;= (A x B) x 2^18 + (A x C)&#xa;Hardware Pipeline Stage 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="box_dsp">
          <mxGeometry x="15" y="160" width="200" height="170" as="geometry" />
        </mxCell>

        <!-- Unpacking & Error Correction -->
        <mxCell id="box_post" value="UNPACKING &amp; BORROW BIT CORRECTION LOGIC" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="80" width="230" height="360" as="geometry" />
        </mxCell>

        <mxCell id="slice_ac" value="Extract Lower 16 bits (Product A x C)&#xa;result_ac [15:0] = dsp_product [15:0]&#xa;Exact Two's Complement INT16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="box_post">
          <mxGeometry x="15" y="45" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="chk_borrow" value="Borrow Bit Detection Circuit&#xa;Check sign bit of sub-product AC:&#xa;borrow_detected = dsp_product[15]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;" vertex="1" parent="box_post">
          <mxGeometry x="15" y="130" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="corr_add" value="+1 Sign Correction Adder&#xa;shift_ab = dsp_product &gt;&gt;&gt; 18&#xa;result_ab = shift_ab + (dsp_product[15] ? 1 : 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="box_post">
          <mxGeometry x="15" y="210" width="200" height="65" as="geometry" />
        </mxCell>

        <mxCell id="slice_ab" value="Restored Upper Product (A x B)&#xa;result_ab [15:0] (INT16 Signed)&#xa;100% Bit-Exact Recovery!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="box_post">
          <mxGeometry x="15" y="295" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Numerical Proof Box -->
        <mxCell id="box_proof" value="NUMERICAL VERIFICATION &amp; MATHEMATICAL PROOF (Tested with Negative Operands)&#xa;Let A = 10, B = 20, C = -15: Expected A x B = +200, A x C = -150.&#xa;• Packed Port B: (20 &lt;&lt; 18) + (-15) = 20 x 262,144 - 15 = 5,242,865.&#xa;• DSP Product: 10 x 5,242,865 = 52,428,650 = 199 x 262,144 + 65,386.&#xa;• Lower 16 bits [15:0]: 65,386 mod 65,536 = -150 (INT16). Sign bit [15] is 1 (Negative!).&#xa;• Upper bits [44:18]: 52,428,650 &gt;&gt;&gt; 18 = 199 (Decremented by 1 due to borrow from 2^18).&#xa;• Correction Addition: 199 + 1 = 200 (Exact match for A x B = +200!)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b5797;fontColor=#ffffff;fontStyle=1;fontSize=11;strokeColor=#1e395b;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1120" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
