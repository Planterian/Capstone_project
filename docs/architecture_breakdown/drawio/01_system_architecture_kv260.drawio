        </mxCell>

        <mxCell id="csr_box" value="Control Plane: AXI4-Lite Register File &amp; CSR (axi_lite_regs.sv)&#xa;0x00: CONTROL [START, RESET] | 0x04: STATUS [BUSY, DONE] | 0x10: SEQ_LEN (N=256, 64, 16)&#xa;0x14: HEAD_DIM (dk=16, 20, 24) | 0x18: HEADS (H=4) | 0x20: SCALE_M | 0x24: SCALE_E | 0x40/0x44: LUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="20" y="40" width="560" height="50" as="geometry" />
        </mxCell>

        <mxCell id="rx_adapter" value="AXI4-Stream RX Skid Buffer&#xa;128-bit S_AXIS_TDATA&#xa;TVALID / TREADY / TLAST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="20" y="110" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ingress_bram" value="Ingress Multi-Bank BRAM&#xa;Q_MEM (256x16 INT8)&#xa;K_MEM (256x16 INT8)&#xa;V_MEM (256x16 INT8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="200" y="105" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fsm_ctrl" value="Top FSM Controller&#xa;Sequential Head 1..4&#xa;Pipeline Staging &amp; Sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="400" y="110" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="stg1_box" value="STAGE 1: QK^T GEMM Engine&#xa;Variant 1A: 16 LUT Multipliers + Adder Tree&#xa;Variant 2A: 8x pe_slice_dsp_packing (DSP48E2 Packing) (Fmax 408 MHz)&#xa;Variant 3B: 4x4 Systolic Array + Reorder Buffer&#xa;Output: INT32 Raw Scores (1 score/cycle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="20" y="180" width="560" height="60" as="geometry" />
        </mxCell>

        <mxCell id="stg2_box" value="STAGE 2: Dyadic Scaler Unit&#xa;(Score x M) >>> E -> INT16 Saturation Clamped [-32768, 32767]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="20" y="250" width="560" height="40" as="geometry" />
        </mxCell>

        <mxCell id="stg3_box" value="STAGE 3: Reconfigurable Hardware IntSoftmax Engine (3-Pass)&#xa;Pass 1: Max-Search | Pass 2: Exp-LUT BRAM (1024w) + Sum | Pass 3: 32-step Divider -> UINT16 [0, 32767]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="20" y="300" width="560" height="45" as="geometry" />
        </mxCell>

        <mxCell id="stg4_box" value="STAGE 4: Context P x V GEMM Engine &amp; Saturation Unit&#xa;Tích lũy 256 tokens, dịch bit >>> 15, kẹp bão hòa INT8 [-128, 127]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="core_top">
          <mxGeometry x="20" y="355" width="370" height="45" as="geometry" />
