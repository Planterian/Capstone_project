        <mxCell id="core_top" value="ATTENTION ACCELERATOR CORE: attention_core_top (v2.0)&#xa;Clock: 200 MHz | Target Device: Kria KV260 | Zero Timing Violations (WNS = +0.051 ns)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#660000;align=center;startSize=30;rounded=1;" vertex="1" parent="pl_box">
